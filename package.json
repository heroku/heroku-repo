{
  "name": "@heroku-cli/plugin-heroku-repo",
  "description": "Heroku CLI plugin to manipulate the repo",
  "version": "3.0.4",
  "author": "Heroku",
  "type": "module",
  "bugs": {
    "url": "https://github.com/heroku/heroku-repo/issues"
  },
  "dependencies": {
    "@heroku-cli/command": "~13.2.0",
    "@heroku-cli/notifications": "^1.2.7",
    "@heroku/heroku-cli-util": "10.10.1",
    "@heroku/http-call": "^5.4.0",
    "@oclif/core": "^4.3.0",
    "bytes": "^3.1.2",
    "debug": "^4.4.0",
    "smooth-progress": "^1.1.0",
    "tar": "^7.0.0"
  },
  "devDependencies": {
    "@heroku-cli/schema": "^2.0.0",
    "@heroku-cli/test-utils": "^1.0.1",
    "@types/bytes": "^3.1.4",
    "@types/debug": "^4.1.12",
    "@types/node": "^26.1.1",
    "@types/tar": "^7.0.87",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9",
    "eslint-config-oclif": "^7.1.8",
    "nock": "^14.0.0",
    "oclif": "^4.23.14",
    "rimraf": "^6.1.3",
    "strip-ansi": "^7",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">= 20"
  },
  "homepage": "https://github.com/heroku/heroku-repo",
  "keywords": [
    "heroku-plugin",
    "oclif"
  ],
  "files": [
    "/dist",
    "/oclif.manifest.json"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "oclif": {
    "repositoryPrefix": "<%- repo %>/blob/plugin-heroku-repo-v<%- version %>/<%- commandPath %>",
    "commands": "./dist/commands",
    "bin": "heroku",
    "topics": {
      "slugs": {
        "description": "Heroku CLI plugin to manipulate the repo"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/heroku/heroku-repo.git"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && tsc -b",
    "manifest": "oclif manifest",
    "readme": "oclif readme",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --coverage.reporter=text-summary --coverage.reporter=lcovonly",
    "docs:generate": "npm run build && npm run manifest && oclif readme --output-dir docs --multi",
    "prepare": "npm run build && npm run manifest",
    "postpack": "rimraf oclif.manifest.json"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
